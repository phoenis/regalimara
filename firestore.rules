rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sostituisci IL-TUO-UID con l'UID del tuo utente (Authentication > Utenti > colonna "UID utente").
    // Usiamo l'UID e non l'email perché questo file è pubblico nel repo e non deve mostrare dati personali.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'IL-TUO-UID';
    }

    // Idee: le legge chiunque, le gestisce solo il proprietario.
    match /ideas/{ideaId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Impostazioni della pagina (per ora l'elenco delle categorie): le legge chiunque, le modifica solo il proprietario.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Prenotazioni: una per idea (l'id del documento è l'id dell'idea).
    // Chiunque abbia un accesso anonimo può crearla, ma solo se non esiste già;
    // la può annullare solo chi l'ha creata (stesso uid) o il proprietario.
    match /reservations/{ideaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && exists(/databases/$(database)/documents/ideas/$(ideaId));
      allow delete: if isOwner() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
